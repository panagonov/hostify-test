# Copy to `.env` (never committed). The suite reads these at start.

# The application under test (production). Everything is derived from the base URL.
QA_BASE_URL=https://hostify.bioseek.eu
# QA_API_URL=https://hostify.bioseek.eu/api

# The super administrator of the platform console (the first journey signs in with it).
QA_SUPERADMIN_EMAIL=
QA_SUPERADMIN_PASSWORD=

# The QA account (tenant) the suite creates once and reuses. The name is the key the suite finds it by —
# keep it unique on the platform and never rename it after the first run.
QA_TENANT_NAME=QA Automation
QA_TENANT_EMAIL=qa.account@hostify-qa.test

# The account administrator the suite creates in that tenant — a known password, so the person can sign in too.
QA_ADMIN_NAME=QA Admin
QA_ADMIN_EMAIL=qa.admin@hostify-qa.test
QA_ADMIN_PASSWORD=
# The other people of the QA account (one per role, spec 100) share this password; the administrator's when unset.
# QA_USERS_PASSWORD=

# Optional switches
# QA_STRICT_VISUAL=1          # low contrast / cut text fail the test (default: recorded as "review")
# QA_FAIL_ON_WARNINGS=1       # console warnings fail the test (default: recorded)
# QA_HEADED=0                 # no browser window (same as `npm run qa:run:headless`); a visible browser is the default
# QA_SLOW_MO=100              # milliseconds between browser actions, to watch a run

# Optional: a GitHub token (repo scope) lets `npm run qa:publish -- --github` open an issue per new bug in this repository.
# QA_GITHUB_TOKEN=
